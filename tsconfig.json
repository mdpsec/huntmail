{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "es2023"
    ],
    "types": [
      "./worker-configuration.d.ts",
      "@cloudflare/vitest-plugin/types",
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "test",
    "scripts",
    "vitest.config.ts"
  ]
}
